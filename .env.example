# Local competition demo. Use NODE_ENV=production and DEMO_MODE=false for actual operations.
PORT=8787
DEMO_MODE=true
AI_MODE=offline
STORAGE_MODE=local
DATA_DIR=./data
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL_MAX=qwen3.8-max
AI_MODEL_FAST=qwen3.8-flash
AI_VISION_MODEL=
AI_TIMEOUT_MS=45000
AI_RETRIES=1
# Optional embedding service; requires a real embedding-capable model.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# 云数据库环境 ID（使用 STORAGE_MODE=cloudbase-sql 时必填）
CLOUDBASE_ENV_ID=
CLOUDBASE_PG_API_KEY=
# Set STORAGE_MODE=cloudbase-sql to use the existing PostgreSQL environment.
# 小程序 AppID 与服务端密钥（仅微信登录需要，仓库内不预置）
WX_APPID=
WX_APP_SECRET=
WX_BRIDGE_SECRET=
# WeChat subscription templates are not configured; reminders are in-app.
